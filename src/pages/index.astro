---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import ProjectPreviewTitle from "@/components/ProjectPreviewTitle.astro";
// import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SOCIALS } from "@/constants";
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Lucy (Xinlu) Zhang
      </h1>

      <!--  链接blog
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
      -->
      <p>Software Developer · Adelaide, Australia</p>
      <p>
        I build secure backend and full-stack applications with Java, Spring
        Boot, React, REST APIs, PostgreSQL, automated testing, and CI/CD.
      </p>
      <p>
        Master of IT, Flinders University (GPA 6.5/7.0) · AWS Certified Cloud
        Practitioner · Full-time work rights in Australia · Available now and
        open to relocation
      </p>
      <p>
        <a
          href="/Lucy_Xinlu_Zhang_CV.pdf"
          class="text-accent hover:underline"
          download>Download CV (PDF) →</a
        >
      </p>
      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="featured-projects" class="border-b border-border pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">Featured Projects</h2>
      <ul class="mt-4 space-y-6">
        <li class="rounded-lg border border-border p-4">
          <h3 class="text-lg font-semibold">CaseFlow Ops</h3>
          <p class="mt-1 text-xs text-foreground/50 italic">
            Building a secure legal matter workflow backend that combines
            role-based and case-assignment authorisation, transactional case and
            client workflows, 37 unit, MockMvc, and PostgreSQL integration
            tests, and documented architecture decision records.
          </p>
          <p class="mt-2 text-xs text-foreground/60">
            Java 21 · Spring Boot · Spring Security · PostgreSQL · Flyway ·
            JUnit · GitHub Actions
          </p>
          <div class="mt-3 flex flex-wrap gap-3">
            <a
              href="https://github.com/zxl3011/caseflow-ops"
              class="text-sm text-accent hover:underline">GitHub →</a
            >
            <span class="text-sm text-foreground/40">In progress</span>
          </div>
        </li>

        <li class="rounded-lg border border-border p-4">
          <h3 class="text-lg font-semibold">
            Surfboard Rental Management System
          </h3>
          <p class="mt-1 text-xs text-foreground/50 italic">
            Built a full-stack board rental platform with a Spring Boot REST
            API, JPQL date-overlap checks that prevent double bookings, and a
            Dockerised backend on Render serving a React frontend on Vercel.
          </p>
          <!--<p class="mt-1 text-sm text-foreground/80">
            Full-stack rental management platform handling booking and inventory workflows.
          </p> -->
          <p class="mt-2 text-xs text-foreground/60">
            Java 21 · Spring Boot · React · TiDB/MySQL · Docker · Render ·
            Vercel
          </p>
          <div class="mt-3 flex gap-3">
            <a
              href="https://surfboard-rental-management.vercel.app"
              class="text-sm text-accent hover:underline">View Project →</a
            >
            <a
              href="https://github.com/zxl3011/surfboard-rental-management"
              class="text-sm text-accent hover:underline">GitHub →</a
            >
          </div>
        </li>

        <li class="rounded-lg border border-border p-4">
          <ProjectPreviewTitle
            headingLevel="h3"
            href="https://stitchflow.xinluzhang.workers.dev/"
            imageAlt="StitchFlow project dashboard showing search, navigation, and a sample crochet workflow"
            imageSrc="/stitchflow-preview.jpg"
            title="StitchFlow"
          />
          <p class="mt-1 text-xs text-foreground/50 italic">
            Designed and shipped a multilingual knitting and crochet workflow
            platform with automatic stitch-count checks, owner-only PostgreSQL
            row-level security, cross-device sync, and private image storage.
          </p>
          <p class="mt-2 text-xs text-foreground/60">
            TypeScript · React · Supabase · PostgreSQL · Cloudflare · Tailwind
            CSS
          </p>
          <div class="mt-3 flex flex-wrap gap-3">
            <a
              href="https://stitchflow.xinluzhang.workers.dev/"
              class="text-sm text-accent hover:underline">View Project →</a
            >
            <a
              href="https://youtu.be/x8B2VpBRKBw"
              class="text-sm text-accent hover:underline">Video Demo →</a
            >
          </div>
        </li>

        <li class="rounded-lg border border-border p-4">
          <h3 class="text-lg font-semibold">
            Workforce Time Management System
          </h3>
          <p class="mt-1 text-xs text-foreground/50 italic">
            Backend developer in an 11-person multinational Agile team,
            clarifying business rules with the PM and BAs and building APIs for
            staff records, salary history, standard hours, overtime, and penalty
            settings.
          </p>
          <!--<p class="mt-1 text-sm text-foreground/80">
            Backend system for workforce records, reporting, and workflow approvals.
          </p> -->
          <p class="mt-2 text-xs text-foreground/60">
            Java · Spring Boot · MySQL · REST APIs · Azure DevOps
          </p>
          <div class="mt-3 flex gap-3">
            <span class="text-sm text-foreground/40"
              >Team project · Code not public</span
            >
          </div>
        </li>

        <li class="rounded-lg border border-border p-4">
          <h3 class="text-lg font-semibold">Indigenous Art Atlas</h3>
          <p class="mt-1 text-xs text-foreground/50 italic">
            Built authentication, sessions, and role-aware user, artist, and
            administrator workflows for a team Leaflet.js art map backed by PHP
            and MySQL.
          </p>
          <p class="mt-2 text-xs text-foreground/60">
            PHP · MySQL · JavaScript · Leaflet.js
          </p>
          <div class="mt-3 flex gap-3">
            <a
              href="https://indigenous-art-atlas.onrender.com"
              class="text-sm text-accent hover:underline">View Project →</a
            >
          </div>
        </li>
      </ul>
    </section>

    <section id="skills" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">Skills</h2>
      <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
        {
          [
            "Java",
            "Python",
            "JavaScript / TypeScript",
            "Spring Boot / Security",
            "React",
            "PostgreSQL / MySQL",
            "JUnit / MockMvc",
            "Docker / GitHub Actions",
            "AWS",
          ].map(skill => (
            <li class="rounded border border-border px-3 py-2 text-center text-sm font-medium">
              {skill}
            </li>
          ))
        }
      </ul>
    </section>

    <div class="my-8 text-center">
      <LinkButton href="/projects">
        All Projects
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
