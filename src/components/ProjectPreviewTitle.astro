---
interface Props {
  headingLevel?: "h2" | "h3";
  href: string;
  imageAlt: string;
  imageSrc: string;
  title: string;
}

const { headingLevel = "h2", href, imageAlt, imageSrc, title } = Astro.props;
const Heading = headingLevel;
const descriptionId = `project-preview-${title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")}`;
---

<div class="project-preview">
  <Heading class="text-lg font-semibold">
    <a
      href={href}
      class="project-preview__trigger"
      aria-describedby={descriptionId}
    >
      {title}
      <span class="project-preview__hint" aria-hidden="true">Preview</span>
    </a>
  </Heading>

  <figure class="project-preview__card" id={descriptionId}>
    <img src={imageSrc} alt={imageAlt} loading="lazy" />
    <figcaption>Live product preview</figcaption>
  </figure>
</div>

<style>
  .project-preview {
    position: relative;
    width: fit-content;
    max-width: 100%;
    z-index: 2;
  }

  .project-preview__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
    text-decoration: none;
  }

  .project-preview__trigger:hover {
    color: var(--color-accent);
  }

  .project-preview__hint {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.45rem;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }

  .project-preview__trigger:hover .project-preview__hint,
  .project-preview__trigger:focus-visible .project-preview__hint {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .project-preview__card {
    pointer-events: none;
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
    width: min(24rem, calc(100vw - 3rem));
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-background);
    box-shadow: 0 1.25rem 3rem
      color-mix(in srgb, var(--color-foreground) 18%, transparent);
    opacity: 0;
    transform: translateY(0.4rem) scale(0.98);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .project-preview__card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
  }

  .project-preview__card figcaption {
    padding: 0.55rem 0.75rem;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    font-size: 0.7rem;
  }

  .project-preview:hover .project-preview__card,
  .project-preview:focus-within .project-preview__card {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (hover: none) {
    .project-preview__hint,
    .project-preview__card {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-preview__card,
    .project-preview__hint {
      transition: none;
    }
  }
</style>
